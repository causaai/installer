# =============================================================================
# images.env — Default component images for the Causa RCA installer
#
# Priority order (highest → lowest):
#   1. CLI flag / exported env var  (e.g. --causa-backend-image or export CAUSA_BACKEND_IMAGE=...)
#   2. Values in this file          (sourced by install.sh at startup)
# =============================================================================

# Kubernetes MCP server
K8S_MCP_SERVER_IMAGE=${K8S_MCP_SERVER_IMAGE:-quay.io/containers/kubernetes_mcp_server:v0.0.62}

# Causa Backend — RCA engine
CAUSA_BACKEND_IMAGE=${CAUSA_BACKEND_IMAGE:-quay.io/rh-ee-shesaxen/causa-backend:adc-fix}

# Causa MCP Server
CAUSA_MCP_IMAGE=${CAUSA_MCP_IMAGE:-quay.io/bmenghan/causa-mcp-server:latest}

# Async Profiler
ASYNC_PROFILER_IMAGE=${ASYNC_PROFILER_IMAGE:-quay.io/causaai/async-profiler:latest}

# Async Profiler MCP Server
ASYNC_PROFILER_MCP_IMAGE=${ASYNC_PROFILER_MCP_IMAGE:-quay.io/causaai/async-profiler-mcp:latest}

# Quarkus MCP Server
QUARKUS_MCP_IMAGE=${QUARKUS_MCP_IMAGE:-quay.io/rh-ee-shesaxen/quarkus-mcp:bobathon}
