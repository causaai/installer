{
  "mcpServers": {
    "kubernetes": {
      "type": "streamable-http",
      "url": "http://kubernetes-mcp-server:8080/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["pods_get", "pods_log", "events_list"],
      "healthCheck": { "url": "http://kubernetes-mcp-server:8080/healthz", "timeoutMs": 5000 },
      "timeoutMs": 5000,
      "description": "Kubernetes MCP — live pod status, events, and container logs from the cluster API",
      "tools": [
        {
          "name": "pods_get",
          "contextKey": "POD_STATUS",
          "description": "Current pod phase, container statuses, restart counts, and resource requests/limits.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}" }
        },
        {
          "name": "events_list",
          "contextKey": "POD_EVENTS",
          "description": "Kubernetes events for the pod (Type, Reason, Message, Timestamp).",
          "arguments": { "namespace": "${namespace}", "fieldSelector": "involvedObject.name=${podName}" }
        },
        {
          "name": "pods_log",
          "contextKey": "POD_LOGS",
          "description": "Current container logs, last 25 lines.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}", "container": "${containerName}", "previous": "false", "tailLines": "25" }
        },
        {
          "name": "pods_log",
          "contextKey": "POD_LOGS_PREVIOUS",
          "description": "Previous (crashed/restarted) container logs, last 25 lines.",
          "arguments": { "name": "${podName}", "namespace": "${namespace}", "container": "${containerName}", "previous": "true", "tailLines": "25" }
        }
      ]
    },
    "quarkus": {
      "type": "streamable-http",
      "url": "http://mcp-metrics:8080/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["fetch_raw_metrics_from_endpoint"],
      "healthCheck": { "url": "http://mcp-metrics:8080/healthz", "timeoutMs": 10000 },
      "timeoutMs": 10000,
      "metadata": { "metricsBaseUrl": "http://mcp-metrics:8080/q/metrics" },
      "description": "Quarkus MCP — raw Prometheus-format metrics scraped from the target application's metrics endpoint",
      "tools": [
        {
          "name": "fetch_raw_metrics_from_endpoint",
          "contextKey": "QUARKUS_RAW_METRICS",
          "description": "Raw Prometheus-format metrics text scraped from the application's /q/metrics endpoint.",
          "arguments": { "pod_name": "${podName}", "namespace": "${namespace}", "baseUrl": "${metadata.metricsBaseUrl}" }
        }
      ]
    },
    "async-profiler": {
      "type": "streamable-http",
      "url": "http://jafra-mcp:8083/mcp",
      "headers": {},
      "optional": false,
      "alwaysAllow": ["list_profiled_pods", "get_pod_jvm_status", "get_jvm_statistics", "get_recording", "get_recording_report", "get_jfr_summary", "get_flame_graph"],
      "healthCheck": { "url": "http://jafra-mcp:8083/q/health/ready", "timeoutMs": 15000 },
      "timeoutMs": 15000,
      "description": "Async Profiler MCP — JVM profiling via async-profiler agent",
      "tools": [
        { "name": "list_profiled_pods", "contextKey": "PROFILED_PODS", "description": "Pods currently registered with the profiler, including their latest recording ID." },
        { "name": "get_pod_jvm_status", "contextKey": "AP_JVM_STATUS", "arguments": { "pod_name": "${podName}" } },
        { "name": "get_jvm_statistics", "contextKey": "AP_JVM_STATISTICS", "arguments": { "pod_name": "${podName}" } },
        { "name": "get_recording", "contextKey": "AP_RECORDING", "description": "Status of the latest recording for this pod.", "arguments": { "recording_id": "${recordingId}", "format": "json" } },
        { "name": "get_flame_graph", "contextKey": "AP_FLAME_GRAPH", "description": "Call-stack frame tree for the latest recording.", "arguments": { "recording_id": "${recordingId}", "format": "json" } },
        { "name": "get_recording_report", "contextKey": "AP_RECORDING_REPORT", "arguments": { "pod": "${podName}", "container": "${containerName}", "namespace": "${namespace}", "last": "5m" } },
        { "name": "get_jfr_summary", "contextKey": "AP_JFR_SUMMARY", "arguments": { "pod": "${podName}", "container": "${containerName}", "namespace": "${namespace}", "last": "5m" } }
      ]
    },
    "prometheus": {
      "type": "streamable-http",
      "url": "http://prometheus-mcp-server:8080/mcp",
      "headers": {},
      "optional": true,
      "alwaysAllow": ["query", "range_query", "healthy", "ready"],
      "healthCheck": { "url": "http://prometheus-mcp-server:8080/metrics", "timeoutMs": 15000 },
      "timeoutMs": 15000,
      "description": "Prometheus MCP — PromQL instant and range queries against the in-cluster Prometheus instance",
      "tools": [
        {
          "name": "query",
          "contextKey": "PROMETHEUS_MEMORY_INSTANT",
          "description": "Instant memory working set for the alerting container at the exact moment the alert fired (bytes).",
          "arguments": {
            "query": "container_memory_working_set_bytes{namespace=\"${namespace}\",pod=\"${podName}\",container=\"${containerName}\"}",
            "timestamp": "${alertTimestamp}"
          }
        },
        {
          "name": "range_query",
          "contextKey": "PROMETHEUS_MEMORY_RANGE",
          "description": "Memory working set trend in the 15 minutes leading up to the alert, 60-second resolution. Rising trend indicates a memory leak.",
          "arguments": {
            "query": "container_memory_working_set_bytes{namespace=\"${namespace}\",pod=\"${podName}\",container=\"${containerName}\"}",
            "start_time": "${alertTimestampMinus15m}",
            "end_time": "${alertTimestamp}",
            "step": "60s"
          }
        }
      ]
    },
    "instana": {
      "type": "streamable-http",
      "url": "http://instana-mcp-server:8080/mcp",
      "headers": {},
      "optional": true,
      "alwaysAllow": ["manage_events", "manage_releases", "manage_applications", "manage_infrastructure", "manage_synthetics", "manage_slo"],
      "healthCheck": { "url": "http://instana-mcp-server:8080/mcp", "timeoutMs": 10000 },
      "timeoutMs": 30000,
      "metadata": {},
      "description": "Instana MCP — K8s events, Golden Signals, JVM snapshots, infra metrics, releases, SLO reports, synthetic tests from IBM Instana APM",
      "tools": [
        {
          "name": "manage_events",
          "contextKey": "INSTANA_K8S_EVENTS",
          "description": "Kubernetes warning/info events with automated analysis",
          "arguments": {
            "operation": "get_kubernetes_info_events",
            "params": { "time_range": "24h", "max_events": 10 }
          }
        },
        {
          "name": "manage_releases",
          "contextKey": "INSTANA_RELEASES",
          "description": "Recent deployment releases correlated with the service",
          "arguments": {
            "operation": "get_all_releases",
            "params": { "name_filter": "${containerName}", "page_number": 1, "page_size": 10 }
          }
        },
        {
          "name": "manage_applications",
          "contextKey": "INSTANA_SERVICE_METRICS",
          "description": "Service-level Golden Signals (calls, errors, latency)",
          "arguments": {
            "resource_type": "metrics",
            "operation": "get_grouped_calls_metrics",
            "params": {
              "group": { "groupbyTag": "service.name", "groupbyTagEntity": "DESTINATION" },
              "metrics": [
                { "metric": "calls", "aggregation": "SUM" },
                { "metric": "erroneousCalls", "aggregation": "SUM" },
                { "metric": "errors", "aggregation": "MEAN" },
                { "metric": "latency", "aggregation": "P95" },
                { "metric": "latency", "aggregation": "MEAN" }
              ],
              "tag_filter_expression": {
                "type": "TAG_FILTER", "name": "service.name",
                "operator": "EQUALS", "entity": "DESTINATION", "value": "${containerName}"
              },
              "time_frame": { "windowSize": 86400000 }
            }
          }
        },
        {
          "name": "manage_applications",
          "contextKey": "INSTANA_ENDPOINT_METRICS",
          "description": "Per-endpoint call/error/latency breakdown",
          "arguments": {
            "resource_type": "metrics",
            "operation": "get_grouped_calls_metrics",
            "params": {
              "group": { "groupbyTag": "endpoint.name", "groupbyTagEntity": "DESTINATION" },
              "metrics": [
                { "metric": "calls", "aggregation": "SUM" },
                { "metric": "erroneousCalls", "aggregation": "SUM" },
                { "metric": "errors", "aggregation": "MEAN" },
                { "metric": "latency", "aggregation": "P95" },
                { "metric": "latency", "aggregation": "MEAN" }
              ],
              "tag_filter_expression": {
                "type": "TAG_FILTER", "name": "service.name",
                "operator": "EQUALS", "entity": "DESTINATION", "value": "${containerName}"
              },
              "time_frame": { "windowSize": 86400000 }
            }
          }
        },
        {
          "name": "manage_infrastructure",
          "contextKey": "INSTANA_INFRA_METRIC_CATALOG",
          "description": "Available JVM infrastructure metrics",
          "arguments": {
            "resource_type": "catalog",
            "operation": "get_metrics",
            "params": { "plugin": "jvmRuntimePlatform" }
          }
        },
        {
          "name": "manage_infrastructure",
          "contextKey": "INSTANA_SNAPSHOTS",
          "description": "Infrastructure snapshots for the service JVM",
          "arguments": {
            "resource_type": "resources",
            "operation": "get_snapshots",
            "params": { "plugin": "jvmRuntimePlatform", "query": "${containerName}", "size": 5 }
          }
        },
        {
          "name": "manage_infrastructure",
          "contextKey": "INSTANA_SNAPSHOT_DETAIL",
          "description": "JVM command-line args, GC config, memory pools (chained from get_snapshots)",
          "arguments": {
            "resource_type": "resources",
            "operation": "get_snapshot",
            "params": { "snapshot_id": "${snapshotId}" }
          }
        },
        {
          "name": "manage_infrastructure",
          "contextKey": "INSTANA_JVM_METRICS",
          "description": "JVM time-series metrics (heap, metaspace, threads)",
          "arguments": {
            "resource_type": "analyze",
            "operation": "get_entities",
            "params": {
              "payload": {
                "type": "jvmRuntimePlatform",
                "metrics": [
                  { "metric": "memory.used", "granularity": 60000, "aggregation": "MAX" },
                  { "metric": "pools.Metaspace", "granularity": 60000, "aggregation": "MAX" },
                  { "metric": "threads.waiting", "granularity": 60000, "aggregation": "SUM" }
                ],
                "tagFilterExpression": {
                  "type": "TAG_FILTER", "entity": "NOT_APPLICABLE",
                  "name": "kubernetes.namespace.name", "operator": "EQUALS",
                  "value": "${namespace}"
                },
                "timeFrame": { "windowSize": 3600000 },
                "pagination": { "retrievalSize": 5 }
              }
            }
          }
        },
        {
          "name": "manage_infrastructure",
          "contextKey": "INSTANA_INFRA_ALERTS",
          "description": "Active infrastructure smart alert configurations",
          "arguments": {
            "resource_type": "alert_config",
            "operation": "find_active"
          }
        },
        {
          "name": "manage_synthetics",
          "contextKey": "INSTANA_SYNTHETIC_TESTS",
          "description": "Synthetic test pass/fail summary",
          "arguments": {
            "resource_type": "test_playback",
            "operation": "get_test_summary_list",
            "params": {
              "payload": {
                "metrics": [{ "metric": "synthetic.metricsStatus", "aggregation": "MEAN", "granularity": 600 }],
                "pagination": { "page": 1, "pageSize": 10 },
                "timeFrame": { "windowSize": 86400000 }
              }
            }
          }
        },
        {
          "name": "manage_slo",
          "contextKey": "INSTANA_SLO_CONFIGS",
          "description": "Discover all configured SLO definitions (chaining source for SLO report)",
          "arguments": {
            "resource_type": "configuration",
            "operation": "get_all",
            "params": { "page_size": 10 }
          }
        },
        {
          "name": "manage_slo",
          "contextKey": "INSTANA_SLO_REPORT",
          "description": "SLO compliance report and error budget status (chained from get_all)",
          "arguments": {
            "resource_type": "report",
            "operation": "get",
            "params": {
              "slo_id": "${sloId}",
              "var_from": "${alertTimestampMinus15m}",
              "to": "${alertTimestamp}"
            }
          }
        }
      ]
    }
  }
}
